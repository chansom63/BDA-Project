# ====================================================================
# FLIGHT TELEMETRY DISTRIBUTED DATA PIPELINE ARCHITECTURE
# CENTRAL ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your keys
# ====================================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=flight_telemetry_jwt_secret_key_demo

# MongoDB Operational Store (Host or Docker internal)
MONGODB_URI=mongodb://localhost:27017/flighttelementary

# Apache Kafka Message Broker
KAFKA_BROKERS=localhost:9093
KAFKA_RAW_TOPIC=flight-telemetry
KAFKA_PROCESSED_TOPIC=processed-events
KAFKA_ANOMALIES_TOPIC=anomalies

# ClickHouse Real-Time OLAP Data Warehouse
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=ch_user
CLICKHOUSE_PASSWORD=ch_password
CLICKHOUSE_DB=default

# Apache Spark Cluster
SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=FlightTelemetryStreamingProcessor

# Hadoop HDFS Distributed File System
HDFS_NAMENODE=hdfs://localhost:9001
WEBHDFS_URL=http://localhost:9870/webhdfs/v1

# Grafana Monitoring
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Apache Airflow Workflow Orchestrator
AIRFLOW_URL=http://localhost:8085
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# Flight Telemetry Simulator Settings
GENERATION_INTERVAL_MS=15000

# OpenSky Network ADS-B Feed (Optional: leave blank for pure simulation mode)
OPENSKY_USERNAME=""
OPENSKY_PASSWORD=""
