# ==============================================================================
# Flight Telemetry & Operations Real-Time Data Engineering Platform
# Environment Configuration (.env)
# ==============================================================================

# Kafka Message Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_FLIGHT_EVENTS=flight-events
TOPIC_TURNAROUND_EVENTS=acdm-turnaround-events
TOPIC_ENGINE_ACARS_EVENTS=engine-acars-events
TOPIC_PASSENGER_DCS_EVENTS=passenger-dcs-events
TOPIC_CREW_CLEARANCE_EVENTS=crew-clearance-events

# MongoDB Operational Storage Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=flight_analytics

# MongoDB Collections
COLL_FLIGHT_EVENTS=flight_events
COLL_TURNAROUND_EVENTS=turnaround_events
COLL_ENGINE_HEALTH_EVENTS=engine_health_events
COLL_PASSENGER_DCS_EVENTS=passenger_dcs_events
COLL_CREW_CLEARANCE_EVENTS=crew_clearance_events
COLL_INGESTION_QUARANTINE=ingestion_quarantine

# Apache Spark Structured Streaming Configuration
SPARK_APP_NAME=RealTimeFlightDataIngestion
SPARK_MASTER=local[*]
CHECKPOINT_DIR=/tmp/spark-checkpoints/flight-ingestion
WATERMARK_DELAY=10 minutes
STREAMING_TRIGGER_PROCESSING_TIME=5 seconds
