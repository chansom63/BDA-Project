# ====================================================================
# MONOLITHIC MERN ARCHITECTURE ON AWS (DATA ANALYTICS PROJECT)
# CENTRAL ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your keys
# ====================================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Database URI (Optional: Leave empty for automated in-memory MongoDB)
MONGODB_URI=

# AWS Account Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# AWS MSK Kafka & Kinesis Streaming
AWS_MSK_CLUSTER_NAME=flight-telemetry-msk-cluster
AWS_MSK_BROKERS=localhost:9092
AWS_MSK_TOPIC=raw-adsb-telemetry-feed
AWS_MSK_PARTITIONS=6
AWS_KINESIS_STREAM_NAME=telemetry-realtime-analytics-stream

# AWS DocumentDB & S3 Data Lake
AWS_DOCUMENTDB_CLUSTER_ID=flight-docdb-cluster
AWS_S3_BUCKET_NAME=aws-flight-telemetry-datalake-prod

# AWS Glue ETL & Redshift Data Warehouse
AWS_GLUE_JOB_NAME=flight-adsb-etl-batch-transform
AWS_REDSHIFT_CLUSTER_ID=flight-analytics-redshift-dw

# AWS QuickSight BI & Notification Services
AWS_QUICKSIGHT_DASHBOARD_ID=flight-operational-telemetry-qs-dash
AWS_SES_SENDER_EMAIL=emergency-dispatch@aviation.aws
AWS_SNS_DEFAULT_PHONE=+1 (800) 555-0199

# External Map & Weather APIs (Optional)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
OPENWEATHER_API_KEY=your_openweather_key_here
