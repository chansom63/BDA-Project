    {
      "id": 9,
      "title": "Most active routes — last hour",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "refId": "A",
          "rawSql": "SELECT\n  concat(origin, ' → ', destination) AS route,\n  countDistinct(flightId) AS flights_observed\nFROM default.flight_telemetry\nWHERE timestamp >= now() - INTERVAL 1 HOUR\n  AND origin != ''\n  AND destination != ''\n  AND flightId != ''\nGROUP BY route\nORDER BY flights_observed DESC\nLIMIT 10",
          "format": 1
        }
      ],
      "description": "Ranks observed flights by route over the last hour. This is not a delay or on-time-performance metric.",
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Latest aircraft state (recently observed flights only)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
