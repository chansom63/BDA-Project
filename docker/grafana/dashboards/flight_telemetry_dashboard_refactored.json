    {
      "id": 8,
      "title": "Recent anomalies and emergencies",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "refId": "A",
          "rawSql": "SELECT\n  timestamp,\n  flightId,\n  callsign,\n  severity,\n  anomalyType,\n  engineTemperature,\n  altitudeFt,\n  speedKnots,\n  squawk,\n  details\nFROM default.flight_anomalies\nWHERE $__timeFilter(timestamp)\nORDER BY timestamp DESC\nLIMIT 100",
          "format": 1
        }
      ],
      "description": "Time-range-filtered and capped at 100 records to keep the panel bounded.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          }
        },
        "overrides": []
      }
