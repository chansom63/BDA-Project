    {
      "id": 1,
      "title": "Flights seen in last 5 minutes",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "refId": "A",
          "rawSql": "SELECT count() AS flights_seen_recently\nFROM (\n  SELECT flightId, max(timestamp) AS last_seen\n  FROM default.flight_telemetry\n  WHERE timestamp >= now() - INTERVAL 5 MINUTE\n    AND flightId != ''\n  GROUP BY flightId\n)",
          "format": 1
        }
      ],
      "description": "Distinct flights with telemetry in the last five minutes; this is an activity proxy, not a certified airborne count.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
