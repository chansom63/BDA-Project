    {
      "id": 5,
      "title": "Fleet average altitude",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "refId": "A",
          "rawSql": "SELECT windowStart AS time, avgAltitude AS \"Average altitude\"\nFROM default.flight_aggregates\nWHERE $__timeFilter(windowStart)\nORDER BY time",
          "format": 0
        }
      ],
      "description": "Reads precomputed Spark windows rather than re-aggregating all raw telemetry on every dashboard refresh.",
      "options": {
