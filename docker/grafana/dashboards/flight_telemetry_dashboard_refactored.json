    },
    {
      "id": 10,
      "title": "Latest known state per flight — last 5 minutes",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "refId": "A",
          "rawSql": "SELECT\n  flightId,\n  argMax(callsign, timestamp) AS callsign,\n  max(timestamp) AS last_update,\n  dateDiff('second', max(timestamp), now()) AS seconds_since_update,\n  argMax(status, timestamp) AS status,\n  argMax(origin, timestamp) AS origin,\n  argMax(destination, timestamp) AS destination,\n  argMax(altitudeFt, timestamp) AS altitude_ft,\n  argMax(speedKnots, timestamp) AS speed_knots,\n  argMax(verticalRateFpm, timestamp) AS vertical_rate_fpm,\n  argMax(engineTemperature, timestamp) AS engine_temp_c,\n  argMax(latitude, timestamp) AS latitude,\n  argMax(longitude, timestamp) AS longitude\nFROM default.flight_telemetry\nWHERE timestamp >= now() - INTERVAL 5 MINUTE\n  AND flightId != ''\nGROUP BY flightId\nORDER BY last_update DESC\nLIMIT 300",
          "format": 1
        }
      ],
      "description": "Shows the latest state among flights observed in the last five minutes. It is bounded to recent data and limited to 300 flights.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          }
        },
        "overrides": []
      }
    }
