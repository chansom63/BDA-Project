          "rawSql": "SELECT toStartOfMinute(event_time) AS time, type AS status, count() AS queries FROM system.query_log WHERE $__timeFilter(event_time) AND type IN ('QueryStart', 'QueryFinish', 'ExceptionWhileProcessing') GROUP BY time, status ORDER BY time ASC",
